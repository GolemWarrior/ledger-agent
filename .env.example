# Database — async driver for FastAPI routes
DATABASE_URL=postgresql+asyncpg://user:password@postgres:5432/ledger

# Database — sync driver for LangGraph background thread (psycopg v3)
DATABASE_URL_SYNC=postgresql+psycopg://user:password@postgres:5432/ledger

# Database — eval schema (isolated; never touches live transactions)
DATABASE_URL_EVAL=postgresql+asyncpg://user:password@postgres:5432/ledger_eval

# Plaid
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Anthropic
ANTHROPIC_API_KEY=

# Postgres service credentials (used by docker-compose postgres service)
POSTGRES_DB=ledger
POSTGRES_USER=user
POSTGRES_PASSWORD=password
